# Copy to .env (git-ignored). Real values never go in a tracked file (ADR 0004).
TL_TOOLS_ACCOUNT=
TL_WORKLOAD_ACCOUNT=
TL_ALERT_EMAIL=
# gh api repos/<org>/tempered-lab/actions/oidc/customization/sub -q .sub_claim_prefix
TL_REPO_SUBJECT=
# Set if the workload account already has a Cost Anomaly Detection services monitor:
#   aws ce get-anomaly-monitors --query 'AnomalyMonitors[?MonitorDimension==`SERVICE`].MonitorArn' --profile <workload>
TL_ANOMALY_MONITOR_ARN=
TL_TOOLS_PROFILE=
TL_WORKLOAD_PROFILE=
# Extra values make scan-history must not find, space-separated (domains, other IDs).
PUBLISH_DENYLIST_EXTRA=
